{
  "name": "invergravital-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/test-ts-resolve.mjs --test \"src/**/*.test.ts\" \"worker/**/*.test.ts\" && node --test supabase/tests/*.test.mjs",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "worker": "node --import ./scripts/test-ts-resolve.mjs worker/index.ts",
    "worker:auth": "node --import ./scripts/test-ts-resolve.mjs worker/googleAuth.ts",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "worker:e2e": "node --import ./scripts/test-ts-resolve.mjs worker/test/e2e.ts",
    "worker:setup": "node --import ./scripts/test-ts-resolve.mjs worker/googleAuth.ts --install-task"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
